# Copy this file to .env and fill only your own keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Alibaba Cloud Model Studio (DashScope) key and the OpenAI-compatible endpoint of
# YOUR workspace region (the ".../compatible-mode/v1" URL shown in the console).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ============================================================
# MODEL ROUTING: the strongest model where the short is made
# ============================================================
# Astra 6 decides DISPUTED caption words (from the ears' evidence; the forced
# aligner alone decides timing) and editorial INTENT (the compiler owns all geometry).
MIMIR_CAPTION_JUDGE_MODEL=gpt-6-astra
MIMIR_CAPTION_JUDGE_REASONING=high
MIMIR_EDIT_DIRECTOR_MODEL=gpt-6-astra
MIMIR_EDIT_DIRECTOR_REASONING=high

# Story: Luna scouts / drafts, Terra decides. The whole-VOD scouting transcript
# stays on the cheap OpenAI path (it never becomes the short's captions).
MIMIR_VOD_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MIMIR_EDITOR_MODEL=gpt-5.6-terra
MIMIR_CLIP_SCOUT_MODEL=gpt-5.6-luna
MIMIR_CLIP_SCOUT_REASONING=medium
MIMIR_CLIP_JUDGE_MODEL=gpt-5.6-terra
MIMIR_CLIP_JUDGE_REASONING=medium
MIMIR_CLIP_JUDGE_ESCALATION_REASONING=high
MIMIR_CLIP_HIGH_ESCALATION_MARGIN=0.35

# Cold open: the model chooses WHICH moment; its length is measured from the event.
MIMIR_TEASER_MODEL=gpt-5.6-luna
MIMIR_TEASER_REASONING=low
MIMIR_TEASER_REVIEW_REASONING=medium
# Headline: drafted by Luna, judged by Terra; no grounded headline -> moving peak without text.
MIMIR_INTRO_DRAFT_MODEL=gpt-5.6-luna
MIMIR_INTRO_DRAFT_REASONING=medium
MIMIR_INTRO_JUDGE_MODEL=gpt-5.6-terra
MIMIR_INTRO_JUDGE_REASONING=medium

MIMIR_SPEAKER_ROLE_MODEL=gpt-5.6-luna
MIMIR_SPEAKER_ROLE_REASONING=low
MIMIR_MEME_MODEL=gpt-5.6-luna
MIMIR_MEME_REASONING=medium
MIMIR_MEME_DISCOVERY_MODEL=gpt-5.6-luna
MIMIR_MEME_DISCOVERY_REASONING=low

# ============================================================
# FINAL CAPTIONS (selected short only)
# ============================================================
# WHAT was said: Qwen Omni listens twice (primary ear; precision ear given the
# verified names as spelling references only). A disagreement gets one small
# independent ear and, if still open, the caption judge above. Then the wording
# is FROZEN; nothing downstream rewrites it.
MIMIR_CAPTION_PRIMARY_PROVIDER=qwen_omni
MIMIR_QWEN_OMNI_MODEL=qwen3.8-omni-flash
MIMIR_QWEN_REASONING_EFFORT=none
MIMIR_QWEN_TIMEOUT_SECONDS=180
MIMIR_QWEN_MAX_RETRIES=1
# Bounded model-diverse ear, used only when needed (Qwen unavailable, material
# A/B disagreement, a disputed phrase): openai_transcribe | none
MIMIR_CAPTION_TRANSCRIBE_FALLBACK_PROVIDER=openai_transcribe
MIMIR_CAPTION_TRANSCRIBE_FALLBACK_MODEL=gpt-transcribe

# WHEN it was said: forced alignment of the frozen words on the final short's
# audio (local model, loaded only for this step). device: auto | cpu | cuda;
# dtype: auto | float32 | float16 | bfloat16.
MIMIR_WORD_ALIGNMENT_PROVIDER=qwen3_forced_aligner
MIMIR_QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
MIMIR_QWEN_ALIGNER_DEVICE=auto
MIMIR_QWEN_ALIGNER_DTYPE=auto
# Re-times the WHOLE transcript only when the aligner cannot produce a valid
# clock (disclosed as a degradation): legacy_whisper | none
MIMIR_WORD_ALIGNMENT_FALLBACK_PROVIDER=legacy_whisper

CAPTION_LANGUAGE=en
# Verified names/brands/places you KNOW occur (comma separated): spelling
# references for the precision ear and the only entities the caption-truth name
# lock may canonicalize. Nothing is guessed.
MIMIR_CAPTION_ENTITIES=

# Speakers (WHO): diarization of the final short; its turns colour the voices (no names).
CAPTION_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
MIMIR_DIARIZATION_VAD_THRESHOLD=0.35
MIMIR_DIARIZATION_VAD_PREFIX_PADDING_MS=300
MIMIR_DIARIZATION_VAD_SILENCE_MS=220

# ============================================================
# PRESENTATION (camera + caption layout; always on)
# ============================================================
# model = one edit-director call per short (Astra, above); rules = free deterministic planner.
MIMIR_PRO_EDIT_PLANNER=model
# preserve keeps the source frame (no forced vertical crop); 9:16 crops explicitly.
MIMIR_PRO_EDIT_OUTPUT_PROFILE=preserve
MIMIR_CAPTION_PLATFORM_PROFILE=generic
MIMIR_CAPTION_BRAND_PROFILE=mimir_default

# ============================================================
# VISUAL SUPPORT
# ============================================================
MIMIR_VISUAL_SUPPORT_MODEL=gpt-5.6-luna
MIMIR_VISUAL_SUPPORT_REASONING=medium
VIDEO_BRAIN_ENABLED=true
VIDEO_BRAIN_MODEL=gemini-3.7-flash
VIDEO_UPLOAD_POLL_SECONDS=3
VIDEO_UPLOAD_TIMEOUT_SECONDS=300
