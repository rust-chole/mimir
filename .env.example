# Copy this file to .env and fill only your own keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================================
# MODEL ROUTING: the strongest model where the short is made
# ============================================================
# Astra 6 decides caption WORDS (from the ears' evidence; the measured clock
# alone decides timing) and editorial INTENT (the compiler owns all geometry).
MIMIR_CAPTION_JUDGE_MODEL=gpt-6-astra
MIMIR_CAPTION_JUDGE_REASONING=high
MIMIR_EDIT_DIRECTOR_MODEL=gpt-6-astra
MIMIR_EDIT_DIRECTOR_REASONING=high

# Story: Luna scouts / drafts, Terra decides.
MIMIR_EDITOR_MODEL=gpt-5.6-terra
MIMIR_CLIP_SCOUT_MODEL=gpt-5.6-luna
MIMIR_CLIP_SCOUT_REASONING=medium
MIMIR_CLIP_JUDGE_MODEL=gpt-5.6-terra
MIMIR_CLIP_JUDGE_REASONING=medium
MIMIR_CLIP_JUDGE_ESCALATION_REASONING=high
MIMIR_CLIP_HIGH_ESCALATION_MARGIN=0.35

# Cold open: the model chooses WHICH moment; its length is measured from the event.
MIMIR_TEASER_MODEL=gpt-5.6-luna
MIMIR_TEASER_REASONING=low
MIMIR_TEASER_REVIEW_REASONING=medium
# Headline: drafted by Luna, judged by Terra; no grounded headline -> moving peak without text.
MIMIR_INTRO_DRAFT_MODEL=gpt-5.6-luna
MIMIR_INTRO_DRAFT_REASONING=medium
MIMIR_INTRO_JUDGE_MODEL=gpt-5.6-terra
MIMIR_INTRO_JUDGE_REASONING=medium

MIMIR_SPEAKER_ROLE_MODEL=gpt-5.6-luna
MIMIR_SPEAKER_ROLE_REASONING=low
MIMIR_MEME_MODEL=gpt-5.6-luna
MIMIR_MEME_REASONING=medium
MIMIR_MEME_DISCOVERY_MODEL=gpt-5.6-luna
MIMIR_MEME_DISCOVERY_REASONING=low

# ============================================================
# CAPTION ACCURACY (selected short only)
# ============================================================
# Whole VOD is scouting material; the published short gets the multi-ear stack:
# primary gpt-transcribe + model-diverse cross-check (with confidence) + Whisper
# word clock, local re-listening of disagreements / low-confidence words, then the
# caption judge (above) decides what the ears did not settle unanimously.
MIMIR_VOD_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MIMIR_CAPTION_ACCURACY_MODE=max
CAPTION_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
CAPTION_LANGUAGE=en
# Cross-check confidence below this sends an agreed word to local re-listening.
MIMIR_CAPTION_LOW_CONFIDENCE_PROB=0.45
# Verified names/brands/places you KNOW occur (comma separated). Only these may
# canonicalize caption spelling; nothing is guessed.
MIMIR_CAPTION_ENTITIES=

MIMIR_DIARIZATION_VAD_THRESHOLD=0.35
MIMIR_DIARIZATION_VAD_PREFIX_PADDING_MS=300
MIMIR_DIARIZATION_VAD_SILENCE_MS=220

# ============================================================
# PRESENTATION (camera + caption layout; always on)
# ============================================================
# model = one edit-director call per short (Astra, above); rules = free deterministic planner.
MIMIR_PRO_EDIT_PLANNER=model
# preserve keeps the source frame (no forced vertical crop); 9:16 crops explicitly.
MIMIR_PRO_EDIT_OUTPUT_PROFILE=preserve
MIMIR_CAPTION_PLATFORM_PROFILE=generic
MIMIR_CAPTION_BRAND_PROFILE=mimir_default

# ============================================================
# VISUAL SUPPORT
# ============================================================
MIMIR_VISUAL_SUPPORT_MODEL=gpt-5.6-luna
MIMIR_VISUAL_SUPPORT_REASONING=medium
VIDEO_BRAIN_ENABLED=true
VIDEO_BRAIN_MODEL=gemini-3.7-flash
VIDEO_UPLOAD_POLL_SECONDS=3
VIDEO_UPLOAD_TIMEOUT_SECONDS=300
