# Production model provider
OPENAI_API_KEY=

# Transcription language
MIMIR_LANGUAGE=en

# Editorial model families (roles route to these unless overridden)
MIMIR_TERRA_MODEL=gpt-5.6-terra
MIMIR_LUNA_MODEL=gpt-5.6-luna

# Per-role override: MIMIR_ROUTE_<ROLE>=model[:effort]   (see `python -m mimir models`)
# MIMIR_ROUTE_EDIT_DIRECTOR=gpt-5.6-terra:high

# Verified names/terms for caption spelling (comma separated)
MIMIR_CAPTION_ENTITIES=

# Face detection uses the bundled YuNet model (mimir/vision/models). Override only if needed:
# MIMIR_FACE_MODEL=/path/to/face_detection_yunet_2023mar.onnx
